  m_Name: LoreN2 5
  m_EditorClassIdentifier: Assembly-CSharp::ItemData
  itemID: LoreN2_05
  nombreDisplay: Sobre tu chip, Nira...
  iconoItem: {fileID: 21300000, guid: 8cc04dd20f7780c4cba83684507a66ae, type: 3}
  tipo: 2
  descripcionLore: "ID: Eurel Valksy (VJ0334)\n\r\nLos AeNeural averiados est\xE1n
    expulsando a sus usuarios de la inmersi\xF3n prometida.\n\nPueden ver el mundo
    real y el mundo virtual al mismo tiempo, la doctora corp est\xE1 muy insatisfecha
    con esto.\n\nLanzaremos una actualizaci\xF3n autom\xE1tica para solucionarlo
    (y de paso, solucionaremos lo de los cerebros rostizados).\n\nSolo que, tu chip
    es un prototipo incapaz de actualizarse remotamente, cuando llegues a la oficina,
    ven a visitarme para actualiz\xE1rtelo.\r\n"
  audioLore: {fileID: 8300000, guid: 20ef100ac05db9242b8c9803eb2da2ad, type: 3}
