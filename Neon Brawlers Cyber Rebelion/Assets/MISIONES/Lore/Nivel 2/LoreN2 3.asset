  m_Name: LoreN2 3
  m_EditorClassIdentifier: Assembly-CSharp::ItemData
  itemID: LoreN2_03
  nombreDisplay: F E L I Z
  iconoItem: {fileID: 21300000, guid: 8cc04dd20f7780c4cba83684507a66ae, type: 3}
  tipo: 2
  descripcionLore: "ID: Fitz Farseer (VJ0287)\n\r\nCreo que la compa\xF1\xEDa nos
    est\xE1 usando, m\xE1s bien, a nuestros cuerpos f\xEDsicos, como un tipo de terminal,
    si.\r\n\r\nDe cierta manera me siento cada d\xEDa m\xE1s cerca de este mundo,
    como si me hablara, son ceros y unos, como deber\xEDa de ser, pero de alguna
    retorcida manera, cada expresi\xF3n que ejerce es entendida por mi cerebro de
    una manera tan fluida y natural, que llego a quedarme viendo a un punto a la
    pared casi fusionado con esta.\n\nSe siente fascinante que el mismo mundo tenga
    inter\xE9s en nosotros como si para eso hubiera sido hecho. Me gusta estar aqu\xED,
    y la verdad, no puedo esperar a hacerme uno con esta realidad.\r\n\r\n"
  audioLore: {fileID: 8300000, guid: 20ef100ac05db9242b8c9803eb2da2ad, type: 3}
  modelo3D: {fileID: 919132149155446097, guid: ba37e0249b710104691add148836ae34, type: 3}
