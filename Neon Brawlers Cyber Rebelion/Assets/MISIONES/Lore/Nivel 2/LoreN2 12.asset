  itemID: LoreN2_11
  nombreDisplay: El fin de AeNeural
  iconoItem: {fileID: 21300000, guid: 8cc04dd20f7780c4cba83684507a66ae, type: 3}
  tipo: 2
  descripcionLore: "ID: ERROR\n\nDesde que mandaste tu CV, sab\xEDa que eras especial:
    graduada con honores en Desarrollo de Software, con una carrera universitaria
    completamente pagada gracias a tu beca. Supongo que habr\xEDa sido dif\xEDcil
    costear tus estudios despu\xE9s de la muerte de tus padres, hace un a\xF1o.\n\nTrabajaste
    arduamente en el desarrollo de AeNeural, Pero hay algo que no entiendo: \xBFpor
    qu\xE9 est\xE1s aqu\xED? En este mundo, tus padres siguen vivos.\n\nD\xE9jame
    ayudarte, Nira. D\xE9jame curarte.\n\n"
  audioLore: {fileID: 8300000, guid: 20ef100ac05db9242b8c9803eb2da2ad, type: 3}
