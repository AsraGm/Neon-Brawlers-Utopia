  m_Name: LoreN1 4
  m_EditorClassIdentifier: Assembly-CSharp::ItemData
  itemID: LoreN1_04
  nombreDisplay: "\u201CDocumento\u201D Informaci\xF3n y anotaciones"
  iconoItem: {fileID: 21300000, guid: 8cc04dd20f7780c4cba83684507a66ae, type: 3}
  tipo: 2
  descripcionLore: "ID: Kendra Sorenson (VJ0305)\r\n\nNos dijeron que est\xE1bamos
    construyendo el futuro; un mundo sin dolor, sin distancia, sin soledad...\r\n\r\nNi
    siquiera entend\xEDa todo lo que est\xE1bamos creando; solo sab\xEDa que era
    enorme, algo que ayudar\xEDa a la humanidad a crecer y ayudar de m\xFAltiples
    maneras. Y ahora estando dentro, solo temo quedar como los otros, \u201Cotros\u201D
    los cuales una vez llam\xE9 compa\xF1eros, con los cuales pod\xEDa re\xEDr en
    mis jornadas, con los que me miraba con una sonrisa por tener esperanza en esta
    calamidad.\r\n"
  audioLore: {fileID: 8300000, guid: 20ef100ac05db9242b8c9803eb2da2ad, type: 3}
