  m_Name: LoreN3 7
  m_EditorClassIdentifier: Assembly-CSharp::ItemData
  itemID: LoreN3_04
  nombreDisplay: Los Poderes
  iconoItem: {fileID: 21300000, guid: 8cc04dd20f7780c4cba83684507a66ae, type: 3}
  tipo: 2
  descripcionLore: "ID: ERROR\n\nToda esta idea de AeNeural comenz\xF3 con una simple
    pregunta: \xBFqu\xE9 pasar\xEDa si los humanos dejaran de preocuparse por vivir?\n\nConstru\xED
    un mundo virtual dise\xF1ado para ayudar a la humanidad: nada de guerras, hambre,
    cansancio, ni dolor. Los poderes dentro de este mundo virtual son, sin duda,
    un extra a la experiencia. \n\n\xBFTe imaginas todo lo que podr\xEDamos hacer?
    \n\nAtraer objetos sin levantarnos, paralizar esos momentos especiales con las
    personas que queremos, o alargar el tiempo tanto como deseemos para darnos todo
    el tiempo que necesitemos para pensar.\n\nHice bien en provocar esos errores
    en los prototipos, pero sab\xEDa que eran peligrosos. Necesitaba probarlos con
    alguien capaz de asimilarlos sin sobrecalentar el chip."
  audioLore: {fileID: 8300000, guid: 20ef100ac05db9242b8c9803eb2da2ad, type: 3}
  modelo3D: {fileID: 919132149155446097, guid: ba37e0249b710104691add148836ae34, type: 3}
